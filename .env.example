# Database Configuration
DATABASE_USER=postgres
DATABASE_PASSWORD=your_database_password_here

# Deployment Configuration (used by Capistrano)
PRODUCTION_IP=your.production.server.ip
DEPLOY_USER=deploy
DEPLOY_RBENV_PATH=/home/deploy/.rbenv
DEPLOY_DIRECTORY=/home/deploy/classroom_console

# Rails Environment
RAILS_ENV=development
RAILS_MAX_THREADS=5
SECRET_KEY_BASE=run_bundle_exec_rails_secret_to_generate_a_key

# Canvas LMS Configuration
# Find these in your Canvas admin settings
CANVAS_PATH=https://your-institution.instructure.com
CANVAS_ACCESS_TOKEN=your_canvas_api_token_here

# OnCampus (Blackbaud) API Configuration
# Contact your Blackbaud administrator for these credentials
ON_API_PATH=https://your-oncampus-server.edu/api
ON_API_USERNAME=your_api_username
ON_API_KEY=your_api_key
ON_API_SECRET=your_api_secret

# OneRoster Configuration (for future migration)
# Contact your Blackbaud administrator for these credentials
ONEROSTER_KEY=your_oneroster_key
ONEROSTER_SECRET=your_oneroster_secret
