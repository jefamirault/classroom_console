<h1><%= @api_name %> Test Result</h1>

<p><%= link_to '← Back to Admin Settings', admin_path %></p>

<% if @error %>
  <div class="alert alert-danger">
    <strong>Request failed:</strong>
    <code><%= @error.class %></code>: <%= @error.message %>
  </div>
  <% if @error.backtrace.present? %>
    <details>
      <summary>Backtrace</summary>
      <pre style="white-space: pre-wrap; word-break: break-all;"><%= @error.backtrace.first(15).join("\n") %></pre>
    </details>
  <% end %>
<% else %>
  <%
    status_code = @response.code.to_s
    success = status_code.start_with?('2')
    content_type = @response['content-type'].to_s
    pretty_body =
      if content_type.include?('json')
        begin
          JSON.pretty_generate(JSON.parse(@response.body.to_s))
        rescue JSON::ParserError
          @response.body
        end
      else
        @response.body
      end
  %>

  <div class="alert <%= success ? 'alert-success' : 'alert-danger' %>">
    <strong><%= success ? 'Success' : 'Failure' %></strong>
    — HTTP <%= @response.code %> <%= @response.message %>
  </div>

  <h2>Status</h2>
  <p><code><%= @response.code %> <%= @response.message %></code></p>

  <h2>Headers</h2>
  <table class="table table-sm table-bordered">
    <thead>
      <tr><th style="width: 25%;">Name</th><th>Value</th></tr>
    </thead>
    <tbody>
      <% @response.each_header do |name, value| %>
        <tr>
          <td><code><%= name %></code></td>
          <td style="word-break: break-all;"><code><%= value %></code></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <h2>Body</h2>
  <% if @response.body.to_s.empty? %>
    <p><em>(empty)</em></p>
  <% else %>
    <pre style="white-space: pre-wrap; word-break: break-all; max-height: 600px; overflow: auto; padding: 0.75rem; background: #f7f7f7; border: 1px solid #ddd;"><%= pretty_body %></pre>
  <% end %>
<% end %>

<p><%= link_to '← Back to Admin Settings', admin_path %></p>
