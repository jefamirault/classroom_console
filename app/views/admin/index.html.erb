<h1>Administrator Settings</h1>

<% if params[:message].present? %>
  <div class="alert alert-info"><%= params[:message] %></div>
<% end %>

<%= form_with model: @admin_settings do |form| %>
  <div class="field">
    <%= form.label :canvas_path, 'Canvas Path' %>
    <%= form.text_field :canvas_path, class: 'form-control' %>
  </div>
  <div class="field">
    <%= form.label :canvas_access_token, 'Canvas Access Token' %>
    <%= form.text_field :canvas_access_token, class: 'form-control' %>
  </div>
  <%= link_to 'Test Canvas Connection', test_canvas_api_path %>
  <br>
  <br>

  <div class="field">
    <%= form.label :on_api_path, 'ON API Path' %>
    <%= form.text_field :on_api_path, class: 'form-control' %>
  </div>
  <div class="field">
    <%= form.label :on_api_username, 'ON API Username' %>
    <%= form.text_field :on_api_username, class: 'form-control' %>
  </div>
  <div class="field">
    <%= form.label :on_api_key, 'ON API Key' %>
    <%= form.text_field :on_api_key, class: 'form-control' %>
  </div>
  <div class="field">
    <%= form.label :on_api_secret, 'ON API Secret' %>
    <%= form.text_field :on_api_secret, class: 'form-control' %>
  </div>
  <%= link_to 'Test ON API Connection', test_on_api_path %>

  <br><br>

  <div class="field">
    <%= form.label :account_id, 'Account ID' %>
    <%= form.number_field :account_id, class: 'form-control' %>
  </div>
  <div class="field">
    <%= form.label :on_api_key, 'SIS School Year' %>
    <%= form.text_field :sis_school_year, class: 'form-control' %>
  </div>
  <div class="field">
    <%= form.label :sis_level_num, 'SIS Level Num' %>
    <%= form.number_field :sis_level_num, class: 'form-control' %>
  </div>
  <div class="field">
    <%= form.label :allow_on_api_read, 'Allow ON API Read' %>
    <%= form.check_box :allow_on_api_read, class: 'form-control' %>
  </div>
  <div class="field">
    <%= form.label :allow_on_api_write, 'Allow ON API Write' %>
    <%= form.check_box :allow_on_api_write, class: 'form-control' %>
  </div>
  <div class="field">
    <%= form.label :allow_canvas_api_read, 'Allow Canvas API Read' %>
    <%= form.check_box :allow_canvas_api_read, class: 'form-control' %>
  </div>
  <div class="field">
    <%= form.label :allow_canvas_api_write, 'Allow Canvas API Write' %>
    <%= form.check_box :allow_canvas_api_write, class: 'form-control' %>
  </div>
  <br>
  <div class="field">
    <%= form.label :oneroster_api_path, 'OneRoster OAuth Token URL' %>
    <%= form.text_field :oneroster_api_path, class: 'form-control', placeholder: 'https://oauth2.sky.blackbaud.com/token' %>
  </div>
  <div class="field">
    <%= form.label :oneroster_key, 'OneRoster API Key' %>
    <%= form.text_field :oneroster_key, class: 'form-control' %>
  </div>
  <div class="field">
    <%= form.label :oneroster_secret, 'OneRoster API Secret' %>
    <%= form.text_field :oneroster_secret, class: 'form-control' %>
  </div>
  <div class="field">
    <%= form.label :oneroster_scope, 'OneRoster OAuth Scope' %>
    <%= form.text_field :oneroster_scope, class: 'form-control', placeholder: 'e.g. https://purl.imsglobal.org/spec/or/v1p1/scope/roster-core.readonly' %>
    <small>Space-separated list of scopes your app is provisioned for.</small>
  </div>
  <%= link_to 'Test OneRoster Connection', test_oneroster_api_path %>
  <br><br>
  <%= form.submit class: 'btn btn-primary', style: 'font-size: 1.125rem; padding: 0.5rem' %>
<% end %>
<br>
Last updated <%= time_ago_in_words(@admin_settings.updated_at) %> ago: <%= @admin_settings.updated_at %>
