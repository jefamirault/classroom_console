<%= form_with(model: sync_profile) do |form| %>
  <% if sync_profile.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(sync_profile.errors.count, "error") %> prohibited this sync profile from being saved:</h2>

      <ul>
        <% sync_profile.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :user_id, "User", style: "display: block" %>
    <%= form.collection_select :user_id, User.order(:name), :id, :to_s, prompt: "Select a user" %>
  </div>

  <div>
    <%= form.label :school_year_id, "School Year", style: "display: block" %>
    <%= form.collection_select :school_year_id, SchoolYear.order(:name), :id, :to_s, prompt: "Select a school year" %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
