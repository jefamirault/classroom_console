<h1>API Test</h1>

<h2>ON API</h2>
<ul>
  <% %w[school_years terms courses sections teacher_sections assignments assignment_grades departments roles users].each do |record| %>
    <li><%= link_to "GET #{record.titleize}", send("on_api_get_#{record}_path") %></li>
  <% end %>
</ul>

